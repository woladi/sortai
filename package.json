{
  "name": "@woladi/sortai",
  "version": "0.2.0",
  "description": "Automatically tag and describe your files using Apple Vision OCR + local Ollama or cloud LLM — writes native Finder tags and comments searchable in Spotlight",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "sortai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "expect tests/e2e/wizard.expect",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "macos",
    "ocr",
    "apple-vision",
    "ollama",
    "tagging",
    "finder-tags",
    "automation",
    "cli",
    "ai"
  ],
  "author": "Adrian Wołczuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woladi/sortai.git"
  },
  "homepage": "https://github.com/woladi/sortai#readme",
  "bugs": {
    "url": "https://github.com/woladi/sortai/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "macos-vision": "^1.4.0",
    "ora": "^8.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.3.6",
    "@types/node": "^20.19.39",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin"
  ]
}
